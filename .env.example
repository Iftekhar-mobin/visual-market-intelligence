# ---------------------------------------------------------------------------
# Visual Market Intelligence - environment configuration
# Copy to .env and edit. Every setting also has a default in configs/default.yaml.
# ---------------------------------------------------------------------------

# Which vision backend to use: ollama | openai_compatible | openrouter | stub
VMI_VISION__PROVIDER=ollama
VMI_VISION__MODEL=qwen2.5vl:7b
VMI_VISION__BASE_URL=http://127.0.0.1:11434
VMI_VISION__TIMEOUT_S=300
VMI_VISION__GROUNDING=window

# Only needed for the openrouter provider. Free-tier models end in ":free".
# Get a key at https://openrouter.ai/keys - the free tier costs nothing.
VMI_VISION__API_KEY=

# API server
VMI_API__HOST=127.0.0.1
VMI_API__PORT=8100
# Comma-separated bearer tokens. Empty means the API is open (local use only).
VMI_API__KEYS=

# Market data: yahoo | metatrader | csv
VMI_DATA__PROVIDER=yahoo
